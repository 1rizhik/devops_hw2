{
    "test_cases": [
        {
            "name": "Health check",
            "endpoint": "/health",
            "method": "GET",
            "expected_status": 200,
            "expected_body_contains": {
                "status": "ok"
            }
        },
        {
            "name": "Predict authentic banknote (request_id=1)",
            "endpoint": "/predict",
            "method": "POST",
            "payload": {
                "request_id": 1
            },
            "expected_status": 200,
            "expected_body_contains": {
                "request_id": 1,
                "prediction": 0
            }
        },
        {
            "name": "Predict fake banknote (request_id=2)",
            "endpoint": "/predict",
            "method": "POST",
            "payload": {
                "request_id": 2
            },
            "expected_status": 200,
            "expected_body_contains": {
                "request_id": 2,
                "prediction": 1
            }
        },
        {
            "name": "Predict not found",
            "endpoint": "/predict",
            "method": "POST",
            "payload": {
                "request_id": 99999
            },
            "expected_status": 404
        },
        {
            "name": "Predictions history",
            "endpoint": "/predictions/1",
            "method": "GET",
            "expected_status": 200
        }
    ]
}